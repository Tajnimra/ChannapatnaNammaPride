<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF5E9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5EDD8"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="☰"
                    android:textSize="22sp"
                    android:textColor="#1A3A2A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦ Namaskara! ✦"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1A3A2A"
                    android:fontFamily="@font/playfair_bold" />

                <Button
                    android:id="@+id/btnLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="ಕನ್ನಡ"
                    android:textSize="11sp"
                    android:backgroundTint="#1A3A2A"
                    android:textColor="#FAF5E9" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Channapatna Namma Pride"
                android:textSize="13sp"
                android:textColor="#5C3A1E"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✦ ಸ್ವಾಗತ ✦"
                android:textSize="13sp"
                android:textColor="#E8A020"
                android:gravity="center"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="12dp"
            android:layout_margin="8dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#D6E8D8"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="bottom">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐴"
                        android:textSize="40sp"
                        android:layout_gravity="end" />

                    <TextView
                        android:id="@+id/btnVerify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verify My Toy"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A3A2A"
                        android:fontFamily="@font/playfair_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter 6-digit ID"
                        android:textSize="11sp"
                        android:textColor="#5C3A1E" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#EDE0C4"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="bottom">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔨"
                        android:textSize="40sp"
                        android:layout_gravity="end" />

                    <TextView
                        android:id="@+id/btnLearn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How It's Made"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#5C3A1E"
                        android:fontFamily="@font/playfair_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Traditional process"
                        android:textSize="11sp"
                        android:textColor="#5C3A1E" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#DDD8E8"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="bottom">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🪆"
                        android:textSize="40sp"
                        android:layout_gravity="end" />

                    <TextView
                        android:id="@+id/btnMaker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meet The Maker"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#3A2A5A"
                        android:fontFamily="@font/playfair_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Discover artisans"
                        android:textSize="11sp"
                        android:textColor="#5C3A1E" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#EDD8D8"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="bottom">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐘"
                        android:textSize="40sp"
                        android:layout_gravity="end" />

                    <TextView
                        android:id="@+id/btnCatalog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toy Catalog"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#8B2020"
                        android:fontFamily="@font/playfair_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Browse collections"
                        android:textSize="11sp"
                        android:textColor="#5C3A1E" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A3A2A"
            android:orientation="horizontal"
            android:padding="18dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Empowering Artisans."
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FAF5E9"
                    android:fontFamily="@font/playfair_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preserving Tradition."
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FAF5E9"
                    android:fontFamily="@font/playfair_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Every toy has a story."
                    android:textSize="11sp"
                    android:textColor="#E8A020"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👨‍🎨"
                android:textSize="48sp"
                android:gravity="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5EDD8"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="14dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500+"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A3A2A"
                    android:fontFamily="@font/playfair_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Artisans"
                    android:textSize="11sp"
                    android:textColor="#5C3A1E" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25+"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A3A2A"
                    android:fontFamily="@font/playfair_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Workshops"
                    android:textSize="11sp"
                    android:textColor="#5C3A1E" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐎"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1000+"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A3A2A"
                    android:fontFamily="@font/playfair_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toys"
                    android:textSize="11sp"
                    android:textColor="#5C3A1E" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏅"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GI"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#8B2020"
                    android:fontFamily="@font/playfair_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Certified"
                    android:textSize="11sp"
                    android:textColor="#5C3A1E" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>