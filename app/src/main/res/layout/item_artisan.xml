<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvArtisanEmoji"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:text="👨‍🎨"
        android:textSize="32sp"
        android:gravity="center"
        android:background="#F5EDD8"
        android:layout_marginEnd="14dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvArtisanName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artisan Name"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A3A2A"
            android:fontFamily="@font/playfair_bold" />

        <TextView
            android:id="@+id/tvArtisanLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Location"
            android:textSize="12sp"
            android:textColor="#5C3A1E"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tvArtisanSpecialty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Specialty"
            android:textSize="11sp"
            android:textColor="#3B7A57"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="24sp"
        android:textColor="#5C3A1E"
        android:layout_gravity="center_vertical" />

</LinearLayout>