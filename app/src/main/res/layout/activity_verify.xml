<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A3A2A"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="←"
            android:textSize="16sp"
            android:backgroundTint="#2D5A3D"
            android:textColor="#FAF5E9"
            android:padding="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify My Toy"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FAF5E9"
                android:fontFamily="@font/playfair_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter 6-digit ID found on your toy"
                android:textSize="12sp"
                android:textColor="#9ABFAA" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF5E9"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Toy ID"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A3A2A"
            android:fontFamily="@font/playfair_bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Type the 6-digit code below"
            android:textSize="13sp"
            android:textColor="#5C3A1E"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etToyId"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:hint="Enter 6-digit ID"
            android:inputType="number"
            android:maxLength="6"
            android:gravity="center"
            android:textSize="28sp"
            android:textColor="#1A3A2A"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF8E7"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐴"
                android:textSize="36sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Where to find ID?"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#5C3A1E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check the bottom of your toy"
                    android:textSize="12sp"
                    android:textColor="#5C3A1E" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnVerifyNow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Verify Now"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#1A3A2A"
            android:textColor="#FAF5E9"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="#1A3A2A"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</LinearLayout>