<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF5E9"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#5A4A7A"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="←"
            android:textSize="16sp"
            android:backgroundTint="#7A6A9A"
            android:textColor="#FAF5E9"
            android:padding="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meet The Maker"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FAF5E9"
                android:fontFamily="@font/playfair_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discover our artisans and workshops"
                android:textSize="12sp"
                android:textColor="#C8B8E8" />

        </LinearLayout>

    </LinearLayout>

    <ListView
        android:id="@+id/lvArtisans"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:padding="12dp" />

</LinearLayout>